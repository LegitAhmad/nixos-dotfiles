// Fresh Niri configuration for the upstream revision pinned in flake.lock.
// Mod is Super in a real session and Alt when nested under another compositor.
// Displays deliberately use automatic mode, scale and placement.
input {
    keyboard {
        xkb { layout "us"; }
        repeat-delay 250
        repeat-rate 35
    }
    touchpad {
        tap
        dwt
        natural-scroll
        scroll-method "two-finger"
    }
    focus-follows-mouse
}

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"
workspace "7"
workspace "8"
workspace "9"

layout {
    gaps 6
    struts {
        top -4
    }
    center-focused-column "never"
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
    focus-ring {
        width 2
        active-gradient from="#89b4fa" to="#cba6f7" angle=45
        inactive-color "#45475a"
    }
    border { off; }
    shadow { off; }
    tab-indicator {
        place-within-column
        position "top"
        gaps-between-tabs 4
        active-color "#cba6f7"
        inactive-color "#45475a"
    }
    background-color "#1e1e2e"
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y-%m-%d_%H-%M-%S.png"
hotkey-overlay { skip-at-startup; }

// niri-session handles the systemd/D-Bus environment and XDG autostart.
// Noctalia owns the bar, wallpaper, notifications, clipboard and session lock.
spawn-at-startup "noctalia"
spawn-at-startup "bash" "-c" "eval $(gnome-keyring-daemon --start --components=pkcs11,secrets,ssh) && dbus-update-activation-environment --all && systemctl --user import-environment SSH_AUTH_SOCK"

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    popups {
        background-effect {
            blur true
        }
    }
}

layer-rule {
    shadow { off; }
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd|window-switcher)$"#
    background-effect {
        blur true
        xray false
    }
}

// Blur for terminals and applications with native background transparency.
// xray false enables scene blur (blurs whatever is behind the window, including other windows).
window-rule {
    match app-id=r#"^(foot|com\.mitchellh\.ghostty|org\.wezfurlong\.wezterm|kitty|Alacritty|alacritty)$"#
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r#"(?i)(helium|firefox|zen|brave|chromium|chrome)"#
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^(foot|com\.mitchellh\.ghostty|org\.wezfurlong\.wezterm|kitty|Alacritty)$"#
    default-column-width { proportion 0.66667; }
}

window-rule {
    match title="^(Picture-in-Picture|Picture in picture)$"
    open-floating true
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^(org\.pulseaudio\.pavucontrol|pavucontrol|nm-connection-editor|blueman-manager)$"#
    open-floating true
    opacity 0.95
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r#"(?i)^(thunar|org\.xfce\.thunar|nautilus|org\.gnome\.nautilus|nemo|dolphin|org\.kde\.dolphin|pcmanfm|pcmanfm-qt|file-roller|org\.gnome\.fileroller|xarchiver|ark|org\.kde\.ark|xdg-desktop-portal-(gtk|gnome|kde))$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.65; }
    opacity 0.95
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id=r#"(?i)^steam$"#
    exclude title=r#"^notificationtoasts_"#
    open-on-workspace "8"
}

window-rule {
    match app-id=r#"(?i)^steam$"# title=r#"^notificationtoasts_"#
    open-floating true
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"(?i)^(com\.obsproject\.Studio|obs)$"#
    open-on-workspace "9"
}

binds {
    Mod+Shift+Slash hotkey-overlay-title="Show keyboard shortcuts" { show-hotkey-overlay; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+B hotkey-overlay-title="Browser" { spawn "helium"; }
    Mod+E hotkey-overlay-title="Files" { spawn "thunar"; }
    Mod+A hotkey-overlay-title="Application launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+W hotkey-overlay-title="Wallpaper picker" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Alt+P hotkey-overlay-title="Color picker" { spawn "hyprpicker" "-a"; }
    Mod+Alt+C hotkey-overlay-title="Toggle PC sharing" { spawn "toggle-pc-sharing"; }
    Mod+N hotkey-overlay-title="Notifications" { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Comma hotkey-overlay-title="Shell settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Delete hotkey-overlay-title="Session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Alt+L repeat=false hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }

    Mod+Q repeat=false { close-window; }
    Mod+O repeat=false hotkey-overlay-title="Workspace overview" { toggle-overview; }
    Mod+grave repeat=false hotkey-overlay-title="Previous workspace" { focus-workspace-previous; }
    Mod+Shift+Tab { focus-column-left-or-last; }
    Mod+Tab { focus-column-right-or-first; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Shift+H { set-column-width "-5%"; }
    Mod+Shift+L { set-column-width "+5%"; }
    Mod+Shift+J { set-window-height "+5%"; }
    Mod+Shift+K { set-window-height "-5%"; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+C { center-column; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Space repeat=false hotkey-overlay-title="Toggle floating" { toggle-window-floating; }
    Mod+Shift+Space repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Ctrl+T repeat=false hotkey-overlay-title="Toggle column tabs" { toggle-column-tabbed-display; }
    Mod+Ctrl+O repeat=false hotkey-overlay-title="Toggle window opacity" { toggle-window-rule-opacity; }

    Mod+Z hotkey-overlay-title="Next occupied workspace" { spawn "/home/legitahmad/nixos-dotfiles/scripts/niri-focus-occupied-workspace.py" "down" "--wrap"; }
    Mod+X hotkey-overlay-title="Previous occupied workspace" { spawn "/home/legitahmad/nixos-dotfiles/scripts/niri-focus-occupied-workspace.py" "up" "--wrap"; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-workspace-up; }
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { spawn "/home/legitahmad/nixos-dotfiles/scripts/niri-focus-occupied-workspace.py" "down"; }
    Mod+WheelScrollUp cooldown-ms=150 { spawn "/home/legitahmad/nixos-dotfiles/scripts/niri-focus-occupied-workspace.py" "up"; }

    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Alt+1 { move-column-to-workspace "1" focus=false; }
    Mod+Alt+2 { move-column-to-workspace "2" focus=false; }
    Mod+Alt+3 { move-column-to-workspace "3" focus=false; }
    Mod+Alt+4 { move-column-to-workspace "4" focus=false; }
    Mod+Alt+5 { move-column-to-workspace "5" focus=false; }
    Mod+Alt+6 { move-column-to-workspace "6" focus=false; }
    Mod+Alt+7 { move-column-to-workspace "7" focus=false; }
    Mod+Alt+8 { move-column-to-workspace "8" focus=false; }
    Mod+Alt+9 { move-column-to-workspace "9" focus=false; }

    Mod+Alt+H { focus-monitor-left; }
    Mod+Alt+J { focus-monitor-down; }
    Mod+Alt+K { focus-monitor-up; }
    Mod+Alt+Right { focus-monitor-right; }
    Mod+Alt+Shift+H { move-column-to-monitor-left; }
    Mod+Alt+Shift+J { move-column-to-monitor-down; }
    Mod+Alt+Shift+K { move-column-to-monitor-up; }
    Mod+Alt+Shift+L { move-column-to-monitor-right; }

    Print repeat=false { screenshot-screen; }
    Mod+Print repeat=false { screenshot; }
    Mod+Shift+Print repeat=false { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    Mod+Shift+N hotkey-overlay-title="Next media track" { spawn "noctalia" "msg" "media" "next"; }
    Mod+Shift+O hotkey-overlay-title="Toggle media playback" { spawn "noctalia" "msg" "media" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "5%-"; }

    // Keep an escape hatch for remote-desktop and software-KVM clients.
    Mod+Escape allow-inhibiting=false repeat=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E repeat=false hotkey-overlay-title="Log out (confirmation)" { quit; }
    Mod+Shift+P repeat=false hotkey-overlay-title="Turn displays off" { power-off-monitors; }
}
